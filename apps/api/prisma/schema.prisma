generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  membres       Member[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Group {
  id               String      @id
  name             String
  invitationSecret String      @unique
  membres          Member[]
  depenses         Expense[]
  services         Service[]
  paybacks         Payback[]

  @@map("group")
}

model Member {
  id       String @id
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupeId String
  groupe   Group  @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  name     String

  @@unique([userId, groupeId])
  @@index([userId])
  @@index([groupeId])
  @@map("member")
}

model Expense {
  id            String                @id
  groupeId      String
  groupe        Group                 @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  label         String
  day           String
  amount        Int
  payerId       String
  participants  ExpenseParticipant[]
  parts         ExpensePart[]

  @@index([groupeId])
  @@map("expense")
}

model ExpenseParticipant {
  depenseId String
  userId    String
  ordinal   Int
  depense   Expense @relation(fields: [depenseId], references: [id], onDelete: Cascade)

  @@id([depenseId, userId])
  @@map("expense_participant")
}

model ExpensePart {
  depenseId String
  userId    String
  amount    Int
  ordinal   Int
  depense   Expense @relation(fields: [depenseId], references: [id], onDelete: Cascade)

  @@id([depenseId, userId])
  @@map("expense_part")
}

model Service {
  id           String               @id
  groupeId     String
  groupe       Group                @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  label        String
  day          String
  amount       Int
  providerId   String
  participants ServiceParticipant[]
  parts        ServicePart[]

  @@index([groupeId])
  @@map("service")
}

model ServiceParticipant {
  serviceId String
  userId    String
  ordinal   Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([serviceId, userId])
  @@map("service_participant")
}

model ServicePart {
  serviceId String
  userId    String
  amount    Int
  ordinal   Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([serviceId, userId])
  @@map("service_part")
}

model Payback {
  id         String @id
  groupeId   String
  groupe     Group  @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  debtorId   String
  creditorId String
  amount     Int

  @@index([groupeId])
  @@map("payback")
}